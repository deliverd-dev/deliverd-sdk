{
  "name": "@deliverd/sdk",
  "version": "0.28.0",
  "description": "Add human approval to any AI agent. Ask a person, wait for the answer, act on it. Start free at deliverd.dev.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "approval",
    "human-in-the-loop",
    "mcp",
    "deliverd"
  ],
  "homepage": "https://deliverd.dev/docs/developers/sdk?utm_source=npm&utm_medium=package&utm_campaign=sdk&utm_content=metadata",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deliverd-dev/deliverd-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://deliverd.dev/contact?utm_source=npm&utm_medium=package&utm_campaign=sdk&utm_content=metadata"
  }
}
